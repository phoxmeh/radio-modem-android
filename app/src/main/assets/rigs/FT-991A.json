 "protocol": "yaesu_ascii",
 "_comment": "Hand-authored from flrig RIG_FT991A (src/rigs/yaesu/FT991A.cxx). Commands end with ';'.",
 "terminator": ";",
 "identify": {
  "send": "ID;",
  "replyRegex": "ID(\\d+);"
 },
 "frequency": {
  "digits": 9,
  "get": "FA;",
  "replyRegex": "FA(\\d{9});",
  "set": "FA{f9};",
  "minHz": 30000,
  "maxHz": 470000000
 },
 "mode": {
  "get": "MD0;",
  "replyRegex": "MD0(.);",
  "set": "MD0{code};"
 },
 "bandwidth": {
  "_comment": "flrig set_bwA: NA0{0|1} selects the narrow filter at low table indexes (SSB < 8, others < 4), then SH0nn sets the width index.",
  "narrowSet": "NA0{narrow};",
  "set": "SH0{n2};",
  "get": "SH0;",
  "replyRegex": "SH0()(\\d\\d);",
  "narrowMaxIndexBySideband": {
   "SSB": 7,
   "CW": 3,
   "DATA": 3,
   "RTTY": 3
  },
  "noBandwidthModes": [
   "FM",
   "AM",
   "FM-N",
   "AM-N",
   "DATA-FM",
   "C4FM"
  ]
 },
 "power": {
  "get": "PC;",
  "replyRegex": "PC(\\d{3});",
  "set": "PC{n3};",
  "min": 5,
  "max": 100
 },
 "smeter": {
  "get": "SM0;",
  "replyRegex": "SM0(\\d{3});",
  "scaleDivisor": 2.56,
  "max": 100
 },
 "powerOut": {
  "get": "RM5;",
  "replyRegex": "RM5(\\d{3});"
 },
 "ptt": {
  "on": "TX1;",
  "off": "TX0;",
  "get": "TX;",
  "replyRegex": "TX(\\d);"
 },
 "notes": [
  "Set the radio's CAT RATE (menu 031) to match the baud rate here; flrig defaults to 38400 with RTS flow control."
 ]
