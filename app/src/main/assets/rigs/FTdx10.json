 "protocol": "yaesu_ascii",
 "_comment": "Hand-authored from flrig RIG_FTdx10 (src/rigs/yaesu/FTdx10.cxx). Commands end with ';'.",
 "terminator": ";",
 "identify": {
  "send": "ID;",
  "replyRegex": "ID(\\d+);"
 },
 "frequency": {
  "digits": 9,
  "get": "FA;",
  "replyRegex": "FA(\\d{9});",
  "set": "FA{f9};",
  "minHz": 30000,
  "maxHz": 75000000
 },
 "mode": {
  "get": "MD0;",
  "replyRegex": "MD0(.);",
  "set": "MD0{code};"
 },
 "bandwidth": {
  "_comment": "flrig set_bwA: SH00nn sets the width index (no separate narrow command).",
  "set": "SH00{n2};",
  "get": "SH0;",
  "replyRegex": "SH0(\\d)(\\d\\d);",
  "narrowMaxIndexBySideband": {},
  "noBandwidthModes": [
   "FM",
   "AM",
   "FM-N",
   "AM-N",
   "DATA-FM",
   "DATA-FMN"
  ]
 },
 "power": {
  "get": "PC;",
  "replyRegex": "PC(\\d{3});",
  "set": "PC{n3};",
  "min": 5,
  "max": 100
 },
 "smeter": {
  "get": "SM0;",
  "replyRegex": "SM0(\\d{3});",
  "scaleDivisor": 2.56,
  "max": 100
 },
 "powerOut": {
  "get": "RM5;",
  "replyRegex": "RM5(\\d{3});"
 },
 "ptt": {
  "on": "TX1;",
  "off": "TX0;",
  "get": "TX;",
  "replyRegex": "TX(\\d);"
 },
 "notes": [
  "flrig uses MD0 for VFO A; the FTDX10's 5-200 W models report PC in watts, 5-100 W on the 100 W model."
 ]
